# Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME="Cloud Event RSVP Tracker"
APP_ENV=development
DEBUG=true

# Security
SECRET_KEY=development-only-secret-key-change-before-deploy
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local development database. For cloud PostgreSQL, use:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=sqlite+aiosqlite:///./event_tracker.db

# Frontend origins (comma-separated when deploying multiple frontends)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Optional: Email notifications (for future use)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
